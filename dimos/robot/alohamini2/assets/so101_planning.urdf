<!--
  Lightweight SO101 planning model.

  Joint frames and limits match so101_new_calib.urdf. Detailed STL visuals
  remain in the AlohaMini2 MuJoCo model; the primitive geometry here keeps
  FK, IK and collision queries inexpensive.
-->
<robot name="so101_planning">
  <material name="so101_yellow">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>
  <material name="servo_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="0.147"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00013"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.075 0.075 0.06"/></geometry>
      <material name="so101_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.065 0.065 0.055"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.03076 0 -0.02527"/>
      <mass value="0.100006"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.000025"/>
    </inertial>
    <visual>
      <origin xyz="-0.027 0 -0.015"/>
      <geometry><box size="0.075 0.055 0.09"/></geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="-0.027 0 -0.015"/>
      <geometry><box size="0.065 0.048 0.08"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="0.8" lower="-1.9198621771937616" upper="1.9198621771937634"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.08985 -0.00838 0.01841"/>
      <mass value="0.103"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.000147" iyz="0" izz="0.000142"/>
    </inertial>
    <visual>
      <origin xyz="-0.064 0 0.018"/>
      <geometry><box size="0.125 0.042 0.04"/></geometry>
      <material name="so101_yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.064 0 0.018"/>
      <geometry><box size="0.115 0.034 0.032"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="0.8" lower="-1.7453292519943224" upper="1.7453292519943366"/>
  </joint>

  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.09807 0.00324 0.01828"/>
      <mass value="0.104"/>
      <inertia ixx="0.000029" ixy="0" ixz="0" iyy="0.00016" iyz="0" izz="0.000145"/>
    </inertial>
    <visual>
      <origin xyz="-0.067 -0.014 0.018"/>
      <geometry><box size="0.133 0.045 0.04"/></geometry>
      <material name="so101_yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.067 -0.014 0.018"/>
      <geometry><box size="0.123 0.036 0.032"/></geometry>
    </collision>
  </link>

  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="0.8" lower="-1.69" upper="1.69"/>
  </joint>

  <link name="wrist_link">
    <inertial>
      <origin xyz="0 -0.03861 0.02812"/>
      <mass value="0.079"/>
      <inertia ixx="0.000037" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000021"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.021"/>
      <geometry><box size="0.05 0.065 0.05"/></geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.03 0.021"/>
      <geometry><box size="0.043 0.055 0.043"/></geometry>
    </collision>
  </link>

  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="0.8" lower="-1.6580628494556928" upper="1.6580627293335335"/>
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0 0 -0.025"/>
      <mass value="0.099"/>
      <inertia ixx="0.000035" ixy="0" ixz="0" iyy="0.000043" iyz="0" izz="0.000035"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.045"/>
      <geometry><box size="0.07 0.065 0.095"/></geometry>
      <material name="so101_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.043"/>
      <geometry><box size="0.055 0.05 0.082"/></geometry>
    </collision>
  </link>

  <joint name="wrist_roll" type="revolute">
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="0.8" lower="-2.7438472969992493" upper="2.841206309382605"/>
  </joint>

  <link name="gripper_frame_link">
    <inertial>
      <mass value="0.000001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/>
    </inertial>
  </link>
  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
  </joint>
</robot>
